@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_LEFT_RIGHT()
HIDE_STEREOTYPE()

title Auto-Flashcards — System Context (Students only)

' ---------- Actors ----------
Person(STUDENT, "Student", "Uses Auto-Flashcards to study")

' ---------- Product Boundary ----------
System_Boundary(PROD, "Auto-Flashcards (Product Boundary) [enterprise]") {
  System(AF, "Auto-Flashcards System", "Generates Q/A (LLM), SRS sessions, analytics, profile")
}

' ---------- External Providers (grouped) ----------
Enterprise_Boundary(ID_STORE, "Identity & Storage") {
  System_Ext(AUTH, "Auth / IdP (OIDC/OAuth)", "Authentication / identity provider")
  System_Ext(STORE, "Object Storage", "Source files & artifacts")
}

Enterprise_Boundary(AI_SVCS, "AI Services") {
  System_Ext(LLM, "LLM Provider", "Q/A generation, concepts")
  System_Ext(OCR, "OCR Provider", "Text extraction from PDFs/images")
}

Enterprise_Boundary(OPS, "Ops & Delivery") {
  System_Ext(NOTIFY, "Notification Service", "Email / Push")
  System_Ext(OBS, "Monitoring/Tracing", "Metrics, logs, LLM tracing")
  System_Ext(BILL, "Billing/Cost Tracker", "LLM cost attribution")
  System_Ext(CDN, "CDN", "Static assets")
}

' ---------- Relationships ----------
Rel(STUDENT, AF, "F1", "HTTPS")
Rel(AF, AUTH, "F3", "OIDC/OAuth")
Rel(AF, LLM, "F4", "HTTPS")
Rel(AF, OCR, "F5", "HTTPS")
Rel(AF, STORE, "F6", "HTTPS / S3")
Rel(AF, NOTIFY, "F7")
Rel(AF, OBS, "MTR")
Rel(AF, BILL, "CST")
Rel(CDN, STUDENT, "CDN", "HTTPS")

' ---------- Legend ----------
legend right
== Use Cases ==
UC-1 Import → OCR/LLM → preview → save
UC-2 Edit / merge cards
UC-3 Daily SRS session
UC-4 Analytics & progress
UC-5 Profile & settings (incl. Auth)

== Flows ==
F1  Student ↔ System (main UX)   [UC-1..UC-5]
F3  System ↔ Auth (OIDC)         [UC-5]
F4  System ↔ LLM (gen/extract)   [UC-1]
F5  System ↔ OCR (text)          [UC-1]
F6  System ↔ Object Storage      [UC-1]
F7  System ↔ Notification        [UC-1/2/3]
CST Cost events → Billing        [UC-1]
MTR Metrics & tracing → OBS      [All]
CDN Static assets → Student      [UI]

== NFR ==
• P95 ≤ 800ms (interactive); UC-1 processing ≤ 60s
• Resume SRS on disconnect; anonymize prompts to externals
• Monitor latency/error/cost; alerts on degradation
endlegend

@enduml
