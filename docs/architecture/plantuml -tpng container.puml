@startuml
' ===== Auto-Flashcards — Plain PlantUML Container Diagram (no external includes) =====
skinparam componentStyle rectangle
skinparam shadowing false
skinparam rectangle {
  StereotypeFontSize 12
  FontSize 12
}

title Auto-Flashcards — Container Diagram (Plain PlantUML)

actor "Student" as Student

cloud "Auth / IdP\n(OIDC/OAuth)" as AUTH
cloud "LLM Provider" as LLM
cloud "OCR Provider" as OCRSVC

rectangle "Auto-Flashcards" as SYSTEM {
  component "Frontend\n(Next.js / React)" as FE
  component "API Backend\n(FastAPI, REST/OpenAPI)" as API
  database "PostgreSQL\n(DB)" as DB
  collections "Object Storage\n(S3-compatible)" as STORE
  component "Job Queue & Workers\n(Celery/RQ)" as Q
  component "LLM Gateway\n(Service)" as GW
  component "OCR Adapter\n(Service)" as OCR
  node "Monitoring & Tracing\n(Prometheus/Grafana + Langfuse)" as MON
}

' --- External interactions
Student --> FE : UI (UC-1..UC-5)
FE --> AUTH : Login / OAuth
FE --> API : REST / JSON

' --- Internal interactions
API --> DB : SQL (CRUD: Decks/Cards/Reviews/Stats/Profile)
API --> STORE : Read/Write files (PDF/raw text) [UC-1]
API --> Q : Enqueue background jobs (OCR/LLM/Aggregations)
API --> GW : LLM requests (generate Q/A, summarize) [UC-1]
API --> OCR : OCR requests (extract text) [UC-1]
API --> MON : Push/pull metrics & traces

GW --> LLM : LLM API
OCR --> OCRSVC : OCR API

' --- UC endpoints cheat sheet
note right of FE
UC-1: POST /decks, GET /decks/{id}/cards
UC-2: PATCH /cards/{id}, POST /cards/merge
UC-3: POST /srs/session/start, POST /srs/grade
UC-4: GET /stats?range=...&deck=...
UC-5: GET/PUT /profile
end note

' --- NFR notes (as comments)
' P95 ≤ 800ms for interactive flows
' Queue long-running tasks (OCR/LLM/Aggregations)
' TLS + minimize data sent to LLM + RBAC
' Prometheus/Grafana + Langfuse for observability

@enduml
