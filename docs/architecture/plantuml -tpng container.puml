@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_LEFT_RIGHT()
HIDE_STEREOTYPE()

Person(student, "Student", "Взаимодействует с Auto-Flashcards через веб-интерфейс")

System_Boundary(sys, "Auto-Flashcards") {
  Container(fe, "Frontend", "Next.js / React", "UI: создать/редактировать колоды и карточки, запускать сессии, смотреть статистику и профиль")
  Container(api, "API Backend", "FastAPI / REST/OpenAPI", "Бизнес-логика: UC-1..UC-5, обработка запросов от фронтенда")
  ContainerDb(db, "PostgreSQL", "Database", "Пользователи, колоды, карточки, результаты повторений, статистика, профиль")
  Container(store, "Object Storage", "S3-compatible", "Исходные файлы (PDF/изображения), нормализованный текст, артефакты")
  Container(queue, "Job Queue & Workers", "Celery / RQ", "Фоновые задания: OCR, генерация Q/A, агрегация статистики")
  Container(gw, "LLM Gateway", "Service", "LLM-троттлинг, ретраи, анонимизация, учёт стоимости")
  Container(ocr, "OCR Adapter", "Service", "Адаптер/нормализация запросов к OCR-провайдеру")
  Container(mon, "Monitoring & Tracing", "Prometheus / Grafana / Langfuse", "Метрики, логи и трейсы")
}

System_Ext(auth, "Auth / IdP (OIDC/OAuth)", "External System", "Аутентификация пользователя")
System_Ext(llm, "LLM Provider", "External System", "Генерация вопросов/ответов и понятий")
System_Ext(ocrsvc, "OCR Provider", "External System", "Извлечение текста из PDF и изображений")

' --- Взаимодействия пользователя
Rel(student, fe, "UI (UC-1..UC-5)", "HTTPS")

' --- Внешние системы
Rel(fe, auth, "Login / OAuth", "OIDC/OAuth")
Rel(fe, api, "REST / JSON", "HTTPS")

Rel(api, db, "SQL CRUD: decks/cards/reviews/stats/profile", "SQL")
Rel(api, store, "Read/Write files (PDF/text)", "S3 API")
Rel(api, queue, "Enqueue background jobs (OCR/LLM/Aggregations)", "Queue")
Rel(api, gw, "LLM requests (generate Q/A, summarize)", "HTTPS")
Rel(api, ocr, "OCR requests (extract text)", "HTTP")
Rel(api, mon, "Push metrics & traces", "OTel / Prometheus")

Rel(queue, gw, "LLM API (batch Q/A generation)", "HTTPS")
Rel(queue, ocr, "OCR API (batch OCR jobs)", "HTTP")
Rel(queue, db, "Update cards & stats", "SQL")
Rel(queue, store, "Read/Write docs & artifacts", "S3 API")
Rel(queue, mon, "Worker metrics & traces", "OTel / Prometheus")

Rel(gw, llm, "LLM API", "HTTPS")
Rel(ocr, ocrsvc, "OCR API", "HTTPS")

@enduml
